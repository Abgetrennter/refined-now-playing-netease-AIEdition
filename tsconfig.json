{
    "include": [
        "./src/**/*"
    ],
    "exclude": [
        "./node_modules/@types/node/**/*.ts",
        "./node_modules"
    ],
    "compilerOptions": {
        "target": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "WebWorker"
        ],
        "module": "ESNext",
        "types": [],
        "jsx": "react",
        "jsxFactory": "React.createElement",
        "jsxFragmentFactory": "React.Fragment",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "strictNullChecks": true,
        "noImplicitAny": true,
        "allowJs": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "outDir": "./dist"
    }
}